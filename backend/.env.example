# Sao chép thành .env và điền giá trị thật (KHÔNG commit .env)
PORT=5000
# Chuỗi kết nối MongoDB Atlas (thay <user>, <password>, <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Tên database theo quy ước MSSV_HoTen
DB_NAME=235692_NguyenPhamGiaHao
# Danh sách origin frontend được phép gọi API, ngăn cách bằng dấu phẩy ("*" = tất cả)
CORS_ORIGIN=http://localhost:5173
